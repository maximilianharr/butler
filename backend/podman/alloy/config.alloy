// =============================================================================
// Grafana Alloy Configuration — Butler Log Collection
// =============================================================================
// Replaces the deprecated Promtail agent.  Collects application log files from
// the shared /usr/src/logs/ volume and podman container stdout/stderr logs,
// then ships everything to Loki.  Each log source carries a distinct "job"
// label so Grafana dashboards can filter per service.
//
// Reference: https://grafana.com/docs/alloy/latest/

// ── Loki write endpoint (shared pod — localhost) ────────────────────────
loki.write "default" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}

// ── API request logs (structured JSON) ──────────────────────────────────
local.file_match "api_requests" {
  path_targets = [{"__path__" = "/usr/src/logs/api-requests.log"}]
}

loki.source.file "api_requests" {
  targets    = local.file_match.api_requests.targets
  forward_to = [loki.process.api_requests.receiver]
}

loki.process "api_requests" {
  forward_to = [loki.relabel.api_requests.receiver]

  stage.json {
    expressions = {
      method      = "method",
      path        = "path",
      status_code = "status_code",
      duration_ms = "duration_ms",
    }
  }
  stage.labels {
    values = {
      method      = "",
      status_code = "",
    }
  }
}

loki.relabel "api_requests" {
  forward_to = [loki.write.default.receiver]

  rule {
    target_label = "job"
    replacement  = "api-requests"
  }
  rule {
    target_label = "source"
    replacement  = "fastapi"
  }
}

// ── Nginx access logs ───────────────────────────────────────────────────
local.file_match "nginx_access" {
  path_targets = [{"__path__" = "/usr/src/logs/nginx-access.log"}]
}

loki.source.file "nginx_access" {
  targets    = local.file_match.nginx_access.targets
  forward_to = [loki.process.nginx_access.receiver]
}

loki.process "nginx_access" {
  forward_to = [loki.relabel.nginx_access.receiver]

  stage.regex {
    expression = "^(?P<remote_addr>\\S+) .* \"(?P<method>\\S+) (?P<path>\\S+) .*\" (?P<status>\\d+)"
  }
  stage.labels {
    values = {
      method = "",
      status = "",
    }
  }
}

loki.relabel "nginx_access" {
  forward_to = [loki.write.default.receiver]

  rule {
    target_label = "job"
    replacement  = "nginx"
  }
  rule {
    target_label = "source"
    replacement  = "access"
  }
}

// ── Nginx error logs ────────────────────────────────────────────────────
local.file_match "nginx_error" {
  path_targets = [{"__path__" = "/usr/src/logs/nginx-error.log"}]
}

loki.source.file "nginx_error" {
  targets    = local.file_match.nginx_error.targets
  forward_to = [loki.relabel.nginx_error.receiver]
}

loki.relabel "nginx_error" {
  forward_to = [loki.write.default.receiver]

  rule {
    target_label = "job"
    replacement  = "nginx"
  }
  rule {
    target_label = "source"
    replacement  = "error"
  }
}

// ── Podman container stdout/stderr logs ─────────────────────────────────
// The k8s-file log driver writes JSON lines to ctr.log per container.
local.file_match "podman_containers" {
  path_targets = [{"__path__" = "/var/log/pods/*/userdata/ctr.log"}]
}

loki.source.file "podman_containers" {
  targets    = local.file_match.podman_containers.targets
  forward_to = [loki.process.podman_containers.receiver]
}

loki.process "podman_containers" {
  forward_to = [loki.relabel.podman_containers.receiver]

  stage.json {
    expressions = {
      log    = "log",
      stream = "stream",
      time   = "time",
    }
  }
  stage.labels {
    values = {
      stream = "",
    }
  }
  stage.output {
    source = "log"
  }
}

loki.relabel "podman_containers" {
  forward_to = [loki.write.default.receiver]

  rule {
    target_label = "job"
    replacement  = "podman-containers"
  }
  rule {
    target_label = "source"
    replacement  = "container-stdout"
  }
}
