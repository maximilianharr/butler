[Unit]
Description=butler Grafana Alloy (Log Shipper to Loki)
After=butler-loki-server.service
After=network-online.target
Wants=butler-loki-server.service

[Container]
Image=localhost/butler/alloy:latest
ContainerName=butler-alloy

Pod=butler.pod

# Alloy River configuration
Volume=%h/butler/server/alloy/config.alloy:/etc/alloy/config.alloy:ro

# Application logs (warehouse ETL, API requests, nginx, PostgreSQL)
Volume=%h/.logs/butler:/usr/src/logs:ro

# Podman container stdout/stderr logs (k8s-file driver)
# NOTE: On the production server install-quadlets.sh replaces this path at
# install time with the fs0 graphRoot path (e.g. /net/<host>/fs0/$USER/...).
# The %h default here keeps WSL and local dev environments working as-is.
Volume=%h/.local/share/containers/storage/overlay-containers:/var/log/pods:ro

Exec=run --server.http.listen-addr=0.0.0.0:12345 --storage.path=/tmp/alloy /etc/alloy/config.alloy

PodmanArgs=--pull=never

[Service]
Restart=always

[Install]
WantedBy=default.target
