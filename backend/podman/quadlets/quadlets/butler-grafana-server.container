[Unit]
Description=butler Grafana Server (Observability Dashboard)
After=butler-loki-server.service
After=network-online.target
Wants=butler-loki-server.service

[Container]
Image=localhost/butler/grafana:latest
ContainerName=butler-grafana-server

# Pod — shares network namespace with all other butler containers
Pod=butler.pod

# Persistent volume for Grafana database, plugins, and user config
Volume=grafana.volume:/var/lib/grafana

# Provisioning: auto-configures Loki as the default datasource
Volume=%h/butler/server/grafana/provisioning:/etc/grafana/provisioning:ro

# Admin password from shared secrets file.
# Add GF_SECURITY_ADMIN_PASSWORD=<your-password> to server/.env.secrets
EnvironmentFile=%h/.config/containers/systemd/server/.env.secrets

# Bypass proxy for Loki datasource queries (Loki runs at localhost:3100 in the same pod).
# Grafana does not load .env.variables, so NO_PROXY must be set explicitly here.
Environment=NO_PROXY=localhost,127.0.0.1
Environment=no_proxy=localhost,127.0.0.1

# Serve Grafana under /grafana/ subpath so nginx can reverse-proxy it
# alongside the existing frontend and API on the same port (8443).
Environment=GF_SERVER_SERVE_FROM_SUB_PATH=true
Environment=GF_SERVER_ROOT_URL=/grafana/
Environment=GF_SERVER_HTTP_PORT=3000

# Pull newer image if available (external Docker Hub image)
PodmanArgs=--pull=newer

[Service]
Restart=always

[Install]
WantedBy=default.target
