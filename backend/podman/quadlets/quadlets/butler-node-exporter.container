[Unit]
Description=butler Node Exporter (System Metrics)
After=network-online.target

[Container]
Image=localhost/butler/node-exporter:latest
ContainerName=butler-node-exporter

Pod=butler.pod

# Mount host filesystems read-only for real system metrics
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro

# node-exporter reads metrics from mounted host paths
Exec=--path.procfs=/host/proc --path.sysfs=/host/sys --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|var/lib/containers/.+)($|/) --no-collector.arp --no-collector.netstat

PodmanArgs=--pull=never

[Service]
Restart=always

[Install]
WantedBy=default.target
